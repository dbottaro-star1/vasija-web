---
/** Title, description, canonical, robots, Open Graph and Twitter tags. Spanish only. */
import { IS_PREVIEW } from '../lib/site';
import { canonicalUrl } from '../lib/url';
import { APP } from '../vasija';

interface Props {
  title: string;
  description: string;
  /** Site-relative path of the page, for example /soporte/. */
  path: string;
  /** Absolute image URL, 1200 by 630. */
  image: string;
  imageAlt: string;
  noindex?: boolean;
}

const { title, description, path, image, imageAlt, noindex = false } = Astro.props;
const canonical = canonicalUrl(path);
const robots =
  noindex || IS_PREVIEW
    ? 'noindex, nofollow'
    : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonical} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={APP.name} />
<meta property="og:locale" content="es_LA" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />
